# 复制为 .env 后只填写本地值，生产环境应由部署平台注入。
DB_NAME=mini_program
DB_USERNAME=mini_program_app
DB_PASSWORD=replace_with_a_strong_password
MYSQL_ROOT_PASSWORD=replace_with_another_strong_password
MYSQL_PORT=3307
DB_URL=jdbc:mysql://localhost:3307/mini_program?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_a_strong_password

SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
