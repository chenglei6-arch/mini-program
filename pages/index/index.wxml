<navigation-bar title="纸韵蛙鸣" back="{{false}}" color="#24342D" background="#F7F4EC"></navigation-bar>

<scroll-view class="page" scroll-y refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="loadSummary">
  <view wx:if="{{loading}}" class="empty-state">正在加载内容...</view>

  <block wx:if="{{!loading && summary}}">
    <view class="brand surface">
      <view class="brand__name">{{summary.brand}}</view>
      <view class="brand__slogan">{{summary.slogan}}</view>
      <view class="brand__note">一场关于剪纸、说部与长白山林蛙的文化探索</view>
    </view>

    <view class="fund surface" bindtap="openWelfare">
      <view>
        <view class="fund__label">公益基金池</view>
        <view wx:if="{{summary.fundAmount}}" class="fund__amount">¥ {{summary.fundAmount}}</view>
        <view wx:else class="fund__amount fund__development">公益基金数据开发中</view>
      </view>
      <view class="fund__action">查看公示 ></view>
    </view>

    <view class="section">
      <view class="section-title">
        <text class="section-title__main">三款游戏</text>
        <text class="section-title__sub">免费体验</text>
      </view>
      <view class="games">
        <view wx:for="{{summary.games}}" wx:key="id" class="game-card surface" data-path="{{item.path}}" bindtap="openGame">
          <view class="game-card__index">0{{index + 1}}</view>
          <view class="game-card__title">{{item.title}}</view>
          <view class="game-card__subtitle">{{item.subtitle}}</view>
          <view class="game-card__link">开始体验 ></view>
        </view>
        <view wx:if="{{summary.games.length === 0}}" class="surface empty-state">游戏内容开发中</view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">
        <text class="section-title__main">林蛙角色墙</text>
        <text class="section-title__sub">{{summary.frogs.length}} 个角色</text>
      </view>
      <view class="frog-grid surface">
        <view wx:for="{{summary.frogs}}" wx:key="id" class="frog-item {{item.unlocked ? 'frog-item--active' : ''}}" data-id="{{item.id}}" bindtap="openFrogDetail">
          <view class="frog-item__avatar-wrap">
            <image wx:if="{{item.assetUrl}}" class="frog-item__avatar" src="{{item.assetUrl}}" mode="aspectFill"></image>
            <view wx:else class="frog-item__avatar">{{item.shortName}}</view>
            <view wx:if="{{!item.unlocked}}" class="frog-item__lock">锁</view>
          </view>
          <view class="frog-item__name">{{item.name}}</view>
          <view class="frog-item__pattern">{{item.pattern}}</view>
        </view>
        <view wx:if="{{summary.frogs.length === 0}}" class="empty-state">角色内容开发中</view>
      </view>
    </view>

    <view class="section activity surface">
      <view class="section-title">
        <text class="section-title__main">蛙友动态</text>
        <text class="section-title__sub" bindtap="openRankings">查看榜单 ></text>
      </view>
      <view wx:for="{{summary.activity}}" wx:key="*this" class="activity__item">{{item}}</view>
      <view wx:if="{{summary.activity.length === 0}}" class="empty-state">蛙友动态开发中</view>
    </view>

    <view class="section home-actions">
      <button class="primary-button" bindtap="scanUnlock">扫码解锁</button>
      <button class="ghost-button" bindtap="openWelfare">公益与徽章</button>
    </view>
  </block>
</scroll-view>

<view wx:if="{{detailVisible}}" class="frog-detail-mask" catchtap="closeFrogDetail">
  <scroll-view class="frog-detail surface" scroll-y="true" catchtap="stopDetailTap">
    <view class="frog-detail__close" aria-label="关闭" bindtap="closeFrogDetail">×</view>
    <view wx:if="{{detailLoading}}" class="empty-state">正在加载说明...</view>
    <block wx:if="{{!detailLoading && frogDetail}}">
      <image class="frog-detail__image" src="{{frogDetail.assetUrl}}" mode="aspectFit"></image>
      <view class="frog-detail__title">{{frogDetail.name}}</view>
      <view class="frog-detail__meta">{{frogDetail.pattern}} · {{frogDetail.blessing}}</view>
      <view wx:for="{{frogDetail.sections}}" wx:key="heading" class="frog-detail__section">
        <view class="frog-detail__heading">{{item.heading}}</view>
        <view wx:for="{{item.paragraphs}}" wx:key="*this" class="frog-detail__paragraph">{{item}}</view>
      </view>
    </block>
  </scroll-view>
</view>
