.order-card {
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
}

.order-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-card__no {
  color: #6f7a72;
  font-size: 23rpx;
}

.order-card__status {
  color: #b4552d;
  font-size: 25rpx;
  font-weight: 600;
}

.order-card__product {
  margin-top: 16rpx;
  color: #24342d;
  font-size: 29rpx;
  font-weight: 600;
}

.order-card__foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 18rpx;
}

.order-card__time {
  color: #879189;
  font-size: 23rpx;
}

.order-card__total {
  color: #b4552d;
  font-size: 30rpx;
  font-weight: 700;
}
