<app-navigation-bar title="确认订单" color="#24342D" background="#F7F4EC"></app-navigation-bar>

<scroll-view class="page" scroll-y>
  <view wx:if="{{loading}}" class="empty-state">正在加载商品...</view>

  <block wx:if="{{!loading && product && !successOrder}}">
    <view class="summary surface">
      <view class="summary__media">
        <image wx:if="{{product.imageUrl}}" class="summary__image" src="{{product.imageUrl}}" mode="aspectFill"></image>
        <view wx:else class="summary__placeholder">{{product.name}}</view>
      </view>
      <view class="summary__body">
        <view class="summary__name">{{product.name}}</view>
        <view wx:if="{{product.subtitle}}" class="summary__subtitle">{{product.subtitle}}</view>
        <view class="summary__price">¥ {{product.priceText}}</view>
      </view>
    </view>

    <view class="section surface form">
      <view class="form__row">
        <text class="form__label">购买数量</text>
        <view class="stepper">
          <view class="stepper__button {{quantity <= 1 ? 'stepper__button--disabled' : ''}}" bindtap="decreaseQuantity">−</view>
          <view class="stepper__value">{{quantity}}</view>
          <view class="stepper__button {{quantity >= 99 ? 'stepper__button--disabled' : ''}}" bindtap="increaseQuantity">＋</view>
        </view>
      </view>
      <view class="form__field">
        <text class="form__label">收货人</text>
        <input class="form__input" placeholder="收货人姓名" value="{{receiverName}}" bindinput="inputName" />
      </view>
      <view class="form__field">
        <text class="form__label">手机号</text>
        <input class="form__input" type="number" maxlength="11" placeholder="收货手机号" value="{{receiverPhone}}" bindinput="inputPhone" />
      </view>
      <view class="form__field">
        <text class="form__label">收货地址</text>
        <textarea class="form__textarea" placeholder="省 / 市 / 区（县）及详细地址" value="{{receiverAddress}}" bindinput="inputAddress" maxlength="200" auto-height></textarea>
      </view>
    </view>

    <view class="total-bar surface">
      <view class="total-bar__label">合计</view>
      <view class="total-bar__amount">¥ {{totalText}}</view>
    </view>
    <button class="primary-button submit-button" loading="{{submitting}}" bindtap="submitOrder">提交订单</button>
    <view class="submit-note">支付通道对接中，提交订单暂不产生扣款</view>
  </block>

  <block wx:if="{{!loading && successOrder}}">
    <view class="success surface">
      <view class="success__icon">✓</view>
      <view class="success__title">下单成功</view>
      <view class="success__order-no">订单号 {{successOrder.orderNo}}</view>
      <view class="success__total">{{successOrder.productName}} × {{successOrder.quantity}} · 合计 ¥ {{successOrder.totalText}}</view>
      <view class="success__note">订单当前为待支付状态</view>
      <button class="primary-button" bindtap="openOrders">查看订单</button>
      <button class="ghost-button back-button" bindtap="backToMall">返回商城</button>
    </view>
  </block>
</scroll-view>
