.product-card {
  overflow: hidden;
}

.product-card__media {
  height: 300rpx;
  background: #1f5c46;
}

.product-card__image {
  width: 100%;
  height: 100%;
}

.product-card__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.product-card__seal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border: 6rpx solid #c9a86a;
  border-radius: 50%;
  color: #f1d39d;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  text-indent: 8rpx;
}

.product-card__body {
  padding: 26rpx 28rpx 30rpx;
}

.product-card__name {
  color: #24342d;
  font-size: 32rpx;
  font-weight: 700;
}

.product-card__subtitle {
  margin-top: 8rpx;
  color: #6f7a72;
  font-size: 24rpx;
}

.product-card__desc {
  margin-top: 14rpx;
  color: #6f7a72;
  font-size: 25rpx;
}

.product-card__footer {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 22rpx;
}

.product-card__price {
  color: #b4552d;
  font-size: 36rpx;
  font-weight: 700;
}

.product-card__action {
  color: #1f5c46;
  font-size: 26rpx;
  font-weight: 600;
}
