.game-summary { display: flex; justify-content: space-between; padding: 28rpx 0 16rpx; color: #5e6a62; }
.paper-board { min-height: 520rpx; padding: 54rpx 32rpx; background: #efe8d9; }
.paper-board--completed { background: #e3ecdf; }
.frog-outline { display: flex; flex-wrap: wrap; justify-content: space-between; max-width: 450rpx; margin: 0 auto; }
.frog-slot { display: flex; align-items: center; justify-content: center; min-height: 120rpx; border: 2rpx dashed #a9a390; border-radius: 10rpx; color: #9b9584; }
.frog-slot { width: 48%; margin-bottom: 18rpx; box-sizing: border-box; }
.frog-slot--filled { border-style: solid; border-color: #1f5c46; background: #1f5c46; color: #fff; }
.frog-slot:last-child { width: 100%; }
.complete-copy { margin-top: 30rpx; color: #1f5c46; font-size: 28rpx; text-align: center; }
.piece-list { display: flex; flex-wrap: wrap; justify-content: space-between; }
.piece { margin: 0; border: 1rpx solid #1f5c46; border-radius: 8rpx; background: #fffdf8; color: #1f5c46; font-size: 24rpx; line-height: 76rpx; }
.piece { width: 31.8%; margin-bottom: 14rpx; box-sizing: border-box; }
.piece::after { border: 0; }
.piece--used { border-color: #d3d0c6; color: #a7aea7; }
.culture { margin-top: 32rpx; padding: 28rpx; }
.culture__title { font-size: 30rpx; font-weight: 700; }
.culture__body { margin-top: 12rpx; color: #6f7a72; font-size: 25rpx; }
.reset { margin-top: 24rpx; }
