.game-summary { display: flex; justify-content: space-between; padding: 28rpx 0 16rpx; color: #5e6a62; }
.puzzle-stage { position: relative; overflow: hidden; padding: 0; background: #fffdf8; }
.puzzle-stage--completed { background: #f1f6ee; }
.puzzle-area { position: relative; display: block; overflow: hidden; }
.board-backdrop { position: absolute; left: 0; top: 0; border-radius: 10rpx; background: #efe8d9; }
.frog-slot { position: absolute; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 2rpx dashed #a9a390; border-radius: 10rpx; color: #9b9584; font-size: 26rpx; }
.frog-slot--filled { border-style: solid; border-color: #1f5c46; background: #1f5c46; color: #fff; }
.palette-title { position: absolute; left: 0; color: #24342d; font-size: 34rpx; font-weight: 700; line-height: 1.3; }
.palette-subtitle { position: absolute; left: 0; color: #7b877f; font-size: 24rpx; line-height: 1.4; }
.piece { z-index: 3; box-sizing: border-box; padding: 0; border: 1rpx solid #1f5c46; border-radius: 10rpx; background: #fffdf8; color: #1f5c46; }
.piece--used { border-color: #1f5c46; background: #1f5c46; color: #fff; }
.piece__content { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; font-size: 25rpx; }
.piece__symbol { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 50%; background: #e3ecdf; color: #1f5c46; font-size: 23rpx; }
.piece__name { margin-left: 10rpx; }
.piece--used .piece__symbol { background: rgba(255, 255, 255, .2); color: #fff; }
.culture { margin-top: 32rpx; padding: 28rpx; }
.culture__title { font-size: 30rpx; font-weight: 700; }
.culture__body { margin-top: 12rpx; color: #6f7a72; font-size: 25rpx; }
.reset { margin-top: 24rpx; }
