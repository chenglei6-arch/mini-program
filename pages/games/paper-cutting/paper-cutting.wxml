<navigation-bar title="指尖剪林蛙" color="#24342D" background="#F7F4EC"></navigation-bar>
<scroll-view class="page" scroll-y>
  <view class="game-summary">
    <text>拼合进度</text>
    <text>{{placedCount}} / {{pieces.length}}</text>
  </view>

  <view wx:if="{{ready}}" class="puzzle-stage surface {{completed ? 'puzzle-stage--completed' : ''}}">
    <movable-area class="puzzle-area" style="width: {{stageWidth}}px; height: {{stageHeight}}px;">
      <view class="board-backdrop" style="width: {{stageWidth}}px; height: {{boardHeight}}px;"></view>
      <view wx:for="{{slots}}" wx:key="id" class="frog-slot {{item.filled ? 'frog-slot--filled' : ''}}" style="left: {{item.left}}px; top: {{item.top}}px; width: {{item.width}}px; height: {{item.height}}px;">
        <text>{{item.filled ? item.filledName : item.number}}</text>
      </view>

      <view class="palette-title" style="top: {{paletteTitleTop}}px;">传统纹样</view>
      <view class="palette-subtitle" style="top: {{paletteSubtitleTop}}px;">拖动纹样碎片到对应槽位</view>

      <movable-view wx:for="{{pieces}}" wx:key="id" class="piece {{item.placed ? 'piece--used' : ''}}" style="width: {{item.width}}px; height: {{item.height}}px;" direction="all" inertia="{{false}}" x="{{item.x}}" y="{{item.y}}" data-index="{{index}}" disabled="{{item.placed}}" bindtouchstart="onPieceTouchStart" bindchange="onPieceChange" bindtouchend="onPieceTouchEnd">
        <view class="piece__content">
          <text class="piece__symbol">{{item.symbol}}</text>
          <text class="piece__name">{{item.name}}</text>
        </view>
      </movable-view>
    </movable-area>
  </view>

  <view class="culture surface">
    <view class="culture__title">纹样解读</view>
    <view class="culture__body">纹样内容、出处与传承人审核信息将在素材定稿后由内容服务统一下发。</view>
  </view>

  <button wx:if="{{completed}}" class="ghost-button reset" bindtap="resetGame">再拼一次</button>
</scroll-view>
