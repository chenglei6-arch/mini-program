<navigation-bar title="青蛙拼图" color="#24342D" background="#F7F4EC"></navigation-bar>
<scroll-view class="page" scroll-y>
  <!-- 青蛙选择器 -->
  <view class="frog-selector">
    <text class="selector-label">选择要拼的青蛙：</text>
    <scroll-view class="frog-list" scroll-x>
      <view wx:for="{{availableFrogs}}" wx:key="id"
        class="frog-option {{selectedFrogId === item.id ? 'selected' : ''}}"
        data-frog-id="{{item.id}}"
        bindtap="onSelectFrog">
        <image src="{{item.assetUrl}}" mode="aspectFit" />
        <text>{{item.shortName}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 拼图进度 -->
  <view class="puzzle-progress" wx:if="{{selectedFrogId}}">
    <text class="progress-text">{{placedComponents.length}} / {{totalComponents}}</text>
  </view>

  <!-- 画布区域 -->
  <view class="canvas-container" wx:if="{{selectedFrogId}}">
    <view class="canvas-wrapper">
      <!-- 已放置的组件（居中叠加） -->
      <view wx:for="{{placedComponents}}" wx:key="id"
        class="placed-component"
        style="z-index: {{item.zIndex}};"
        data-index="{{index}}"
        bindtap="onComponentTap">
        <image src="{{item.assetUrl}}" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 组件库 -->
  <view class="components-library" wx:if="{{selectedFrogId}}">
    <view class="library-header">
      <text class="library-title">组件库</text>
      <text class="library-hint">点击添加组件</text>
    </view>
    <scroll-view class="component-list" scroll-x>
      <view wx:for="{{frogComponents}}" wx:key="id"
        class="component-item {{item.unlocked ? '' : 'locked'}} {{item.placed ? 'used' : ''}}"
        data-component-id="{{item.id}}"
        bindtap="onAddComponent">
        <image src="{{item.assetUrl}}" mode="aspectFit" />
        <text class="component-name">{{item.name}}</text>
        <view class="used-badge" wx:if="{{item.placed}}">✓</view>
        <view class="lock-badge" wx:if="{{!item.unlocked}}">🔒</view>
      </view>
    </scroll-view>
  </view>

  <!-- 完成提示 -->
  <view class="complete-overlay" wx:if="{{completed}}" bindtap="onCloseComplete">
    <view class="complete-card" catchtap="stopPropagation">
      <view class="complete-close" aria-label="关闭" bindtap="onCloseComplete">×</view>
      <text class="complete-title">拼图完成！</text>
      <image class="complete-frog" src="{{completedFrogImage}}" mode="aspectFit" />
      <text class="complete-subtitle">{{selectedFrogName}}</text>
      <button class="action-btn primary" bindtap="onViewCulture">查看文化解读</button>
      <button class="action-btn" bindtap="onSelectAnother">拼其他青蛙</button>
    </view>
  </view>
</scroll-view>

<!-- 文化解读弹窗：复用角色墙的单一滚动详情布局，避免嵌套 flex 滚动导致文字溢出 -->
<view wx:if="{{showCultureModal}}" class="culture-modal" bindtap="hideCultureModal">
  <scroll-view class="culture-detail" scroll-y="true" catchtap="stopPropagation">
    <view class="culture-detail__close" aria-label="关闭" bindtap="hideCultureModal">×</view>
    <view wx:if="{{cultureData}}">
      <image class="culture-detail__image" src="{{cultureData.assetUrl}}" mode="aspectFit" />
      <view class="culture-detail__title">{{cultureData.name}}</view>
      <view class="culture-detail__meta">{{cultureData.pattern}} · {{cultureData.blessing}}</view>
      <view wx:for="{{cultureData.sections}}" wx:key="heading" class="culture-detail__section">
        <view class="culture-detail__heading">{{item.heading}}</view>
        <view wx:for="{{item.paragraphs}}" wx:key="*this" class="culture-detail__paragraph">{{item}}</view>
      </view>
    </view>
  </scroll-view>
</view>
