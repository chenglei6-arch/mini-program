.guardian-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f7f4ec;
  padding-bottom: 40rpx;
}

/* 主舞台 */
.guardian-stage {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 520rpx;
  margin: 30rpx 24rpx;
  padding: 40rpx 32rpx;
  background: #e7efe6;
  border-radius: 24rpx;
}

.guardian-stage__empty,
.guardian-stage__loading {
  color: #6f7a72;
  font-size: 28rpx;
  text-align: center;
}

.retry-button {
  margin-top: 24rpx;
}

/* 完成状态 */
.guardian-finished {
  text-align: center;
}

.guardian-finished__icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.guardian-finished__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #24342d;
  margin-bottom: 16rpx;
}

.guardian-finished__desc {
  font-size: 28rpx;
  color: #6f7a72;
}

/* 挑战状态 */
.guardian-challenge {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.guardian-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  height: 220rpx;
  border: 4rpx solid #1f5c46;
  border-radius: 50%;
  background: #fff;
  overflow: hidden;
}

.guardian-avatar__image {
  width: 100%;
  height: 100%;
}

.guardian-avatar text {
  color: #1f5c46;
  font-size: 64rpx;
  font-weight: 700;
}

.guardian-name {
  margin-top: 28rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #24342d;
}

.guardian-copy {
  margin-top: 8rpx;
  color: #6f7a72;
  font-size: 26rpx;
}

.guardian-options {
  display: flex;
  justify-content: space-between;
  width: 100%;
  margin-top: 32rpx;
  gap: 12rpx;
}

.option-button {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  margin: 0;
  background: #fff;
  border: 2rpx solid #d0d7ce;
  border-radius: 12rpx;
  color: #24342d;
  font-size: 28rpx;
}

.option-button.selected {
  background: #1f5c46;
  border-color: #1f5c46;
  color: #fff;
}

.option-button[disabled] {
  opacity: 0.6;
}

/* 待抽取状态 */
.guardian-idle {
  width: 100%;
  text-align: center;
}

.guardian-idle__icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.guardian-idle__title {
  font-size: 36rpx;
  font-weight: 700;
  color: #24342d;
  margin-bottom: 16rpx;
}

.guardian-idle__info {
  font-size: 26rpx;
  color: #6f7a72;
  margin-bottom: 32rpx;
}

.share-tip {
  color: #bc7b2a;
  margin-left: 8rpx;
}

.draw-button {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  margin-top: 10px;
  height: 96rpx;
  line-height: 96rpx;
  background: #1f5c46;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.draw-button.shaking {
  animation: shake 0.5s ease-in-out infinite;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  10%, 30%, 50%, 70%, 90% { transform: translateX(-8rpx); }
  20%, 40%, 60%, 80% { transform: translateX(8rpx); }
}

.share-button {
  display: flex;
  justify-content: center;
  align-content: center;
  width: 100%;
  height: 88rpx;
  /* line-height: 88rpx; */
  margin-top: 16rpx;
  background: transparent;
  border: 2rpx solid #bc7b2a;
  border-radius: 44rpx;
  color: #bc7b2a;
  font-size: 28rpx;
}

/* 收集图鉴 */
.collection-section,
.badges-section {
  margin: 24rpx 24rpx 0;
  padding: 32rpx;
  background: #fff;
  border-radius: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #24342d;
}

.section-count {
  font-size: 28rpx;
  color: #6f7a72;
}

.collection-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.collection-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: #f7f4ec;
  border-radius: 16rpx;
}

.collection-card.locked {
  opacity: 0.4;
}

.collection-card__avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.collection-card__avatar {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1f5c46;
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
}

.collection-card__avatar-wrap image {
  width: 100%;
  height: 100%;
}

.collection-card__lock {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}

.collection-card__name {
  font-size: 24rpx;
  color: #24342d;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.collection-card__pattern {
  font-size: 20rpx;
  color: #1f5c46;
}

/* 徽章列表 */
.badges-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.badge-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f7f4ec;
  border-radius: 16rpx;
}

.badge-item.locked {
  opacity: 0.5;
}

.badge-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
  border-radius: 50%;
}

.badge-icon--bronze {
  background: #cd7f32;
}

.badge-icon--silver {
  background: #c0c0c0;
}

.badge-icon--gold {
  background: #ffd700;
}

.badge-name {
  font-size: 28rpx;
  color: #24342d;
  font-weight: 600;
}

/* 结果弹窗 */
.result-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  padding: 40rpx;
}

.result-modal__content {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  text-align: center;
}

.result-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.result-message {
  font-size: 32rpx;
  font-weight: 700;
  color: #24342d;
  margin-bottom: 32rpx;
}

.guardian-card {
  padding: 32rpx;
  background: #f7f4ec;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.guardian-card__avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  margin: 0 auto 16rpx;
}

.guardian-card__avatar {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1f5c46;
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
}

.guardian-card__avatar-wrap image {
  width: 100%;
  height: 100%;
}

.guardian-card__label {
  color: #bc7b2a;
  font-size: 22rpx;
  margin-bottom: 12rpx;
}

.guardian-card__name {
  font-size: 36rpx;
  font-weight: 700;
  color: #24342d;
  margin-bottom: 8rpx;
}

.guardian-card__pattern {
  font-size: 28rpx;
  color: #1f5c46;
  margin-bottom: 8rpx;
}

.guardian-card__blessing {
  font-size: 24rpx;
  color: #6f7a72;
  line-height: 1.6;
  margin-top: 16rpx;
}

.unlocked-badges {
  margin-bottom: 24rpx;
}

.unlocked-badges__title {
  font-size: 28rpx;
  color: #24342d;
  margin-bottom: 16rpx;
}

.unlocked-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  background: #f7f4ec;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.unlocked-badge__icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.unlocked-badge__name {
  font-size: 26rpx;
  color: #24342d;
}

.close-button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #1f5c46;
  color: #fff;
  border-radius: 44rpx;
  font-size: 28rpx;
}

