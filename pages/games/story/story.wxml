<app-navigation-bar title="林蛙谷寻踪" color="#24342D" background="#F7F4EC"></app-navigation-bar>
<scroll-view class="page" scroll-y>
  <view wx:if="{{loading}}" class="empty-state">正在回想谷中的故事...</view>

  <block wx:if="{{!loading && state}}">
    <view class="story-head surface">
      <view class="story-head__title">林蛙谷寻踪</view>
      <view class="story-head__copy">已探索 {{progress.completed}} / {{progress.total}} 条路线</view>
      <view class="route-dots">
        <view wx:for="{{routeIds}}" wx:key="*this" class="route-dot {{state.completedRoutes.indexOf(item) >= 0 ? 'route-dot--done' : ''}}">{{item}}</view>
      </view>
    </view>

    <view class="narrative surface">
      <view class="narrative__eyebrow">{{state.speaker}} · {{state.sceneId}}</view>
      <view class="narrative__title">{{state.sceneTitle}}</view>
      <view class="narrative__body" bindtap="revealAll">
        <block wx:if="{{state.sceneParagraphs && state.sceneParagraphs.length}}">
          <block wx:for="{{state.sceneParagraphs}}" wx:key="*this">
            <view wx:if="{{index < revealed}}" class="narrative__paragraph">{{item}}</view>
          </block>
        </block>
        <text wx:else>{{state.sceneText}}</text>
        <view wx:if="{{typing}}" class="narrative__skip">轻触正文跳过</view>
      </view>

      <view wx:if="{{state.choices.length && !typing}}" class="choices">
        <button wx:for="{{state.choices}}" wx:key="id" class="ghost-button choice" loading="{{submitting}}" disabled="{{submitting}}" data-choice-id="{{item.id}}" bindtap="choose">
          <view class="choice__label">{{item.label}}</view>
          <view wx:if="{{item.hint}}" class="choice__hint">{{item.hint}}</view>
        </button>
      </view>

      <view wx:if="{{state.ending}}" class="ending">
        <view class="ending__label">{{state.ending.label}}</view>
        <view class="ending__title">{{state.ending.title}}</view>
        <view class="ending__text">{{state.ending.text}}</view>
      </view>
    </view>

    <view wx:if="{{state.inventory.length || state.notes.length}}" class="story-meta">
      <view wx:if="{{state.inventory.length}}" class="meta-block surface">
        <view class="meta-block__title">行囊</view>
        <view wx:for="{{state.inventory}}" wx:key="*this" class="meta-block__item">{{item}}</view>
      </view>
      <view wx:if="{{state.notes.length}}" class="meta-block surface">
        <view class="meta-block__title">风物札记</view>
        <view wx:for="{{state.notes}}" wx:key="*this" class="meta-block__item">{{item}}</view>
      </view>
    </view>

    <view class="story-actions">
      <button class="ghost-button" loading="{{resetting}}" disabled="{{submitting || resetting}}" bindtap="resetStory">重新开始</button>
    </view>
  </block>
</scroll-view>
