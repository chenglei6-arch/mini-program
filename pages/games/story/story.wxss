.story-head { margin-top: 28rpx; padding: 34rpx; background: #28463a; border: 0; color: #fff; }
.story-head__title { font-size: 38rpx; font-weight: 700; }
.story-head__copy { margin-top: 12rpx; color: #c8d7cf; font-size: 25rpx; }
.chapter-list { display: grid; gap: 16rpx; margin-top: 24rpx; }
.chapter { position: relative; padding: 28rpx; }
.chapter__number { color: #bc7b2a; font-size: 22rpx; }
.chapter__title { margin-top: 8rpx; font-size: 31rpx; font-weight: 700; }
.chapter__action { position: absolute; right: 28rpx; bottom: 30rpx; color: #1f5c46; font-size: 23rpx; }
.narrative { margin-top: 24rpx; padding: 36rpx 30rpx; }
.narrative__eyebrow { color: #bc7b2a; font-size: 23rpx; }
.narrative__title { margin-top: 8rpx; font-size: 36rpx; font-weight: 700; }
.narrative__body { margin-top: 42rpx; color: #3f5047; font-size: 29rpx; line-height: 1.9; }
.choices { display: grid; gap: 16rpx; margin-top: 48rpx; }
.choice { width: 100%; margin: 0; }
