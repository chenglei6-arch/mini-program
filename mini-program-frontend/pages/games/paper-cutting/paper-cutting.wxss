/* 页面容器 */
.page {
  min-height: 100vh;
  background: #F7F4EC;
  padding-bottom: 40rpx;
}

/* 青蛙选择器 */
.frog-selector {
  padding: 32rpx;
  background: #FFFFFF;
  margin-bottom: 24rpx;
}

.selector-label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #24342D;
  margin-bottom: 16rpx;
}

.frog-list {
  white-space: nowrap;
  padding: 16rpx 0;
}

.frog-option {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: 140rpx;
  margin-right: 24rpx;
  padding: 16rpx;
  background: #F5F5F5;
  border-radius: 20rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.frog-option.selected {
  background: #E8F5E9;
  border-color: #4CAF50;
}

.frog-option image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
}

.frog-option text {
  font-size: 24rpx;
  color: #24342D;
}

/* 拼图进度 */
.puzzle-progress {
  text-align: center;
  padding: 16rpx 32rpx;
  background: #FFFFFF;
  margin-bottom: 24rpx;
}

.progress-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #4CAF50;
}

/* 画布容器 */
.canvas-container {
  margin: 0 32rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.canvas-wrapper {
  position: relative;
  width: 100%;
  padding-bottom: 100%; /* 1:1 正方形 */
  background: #FAFAFA;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 已放置的组件 */
.placed-component {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.placed-component image {
  width: 100%;
  height: 100%;
}

/* 组件库 */
.components-library {
  margin: 0 32rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.library-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.library-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #24342D;
}

.library-hint {
  font-size: 24rpx;
  color: #999;
}

.component-list {
  white-space: nowrap;
  padding: 16rpx 0;
}

.component-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: 140rpx;
  margin-right: 24rpx;
  padding: 16rpx;
  background: #F5F5F5;
  border-radius: 20rpx;
  position: relative;
  transition: transform 0.2s;
}

.component-item:active {
  transform: scale(0.95);
}

.component-item.used {
  opacity: 0.5;
}

.component-item.locked {
  opacity: 0.4;
}

.component-item image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
}

.component-name {
  font-size: 24rpx;
  color: #24342D;
  text-align: center;
}

.used-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: #4CAF50;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.lock-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  font-size: 32rpx;
}

/* 完成遮罩 */
.complete-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
}

.complete-card {
  position: relative;
  width: 80%;
  max-width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.complete-close {
  position: absolute;
  top: 12rpx;
  right: 20rpx;
  width: 56rpx;
  height: 56rpx;
  color: #7B877F;
  font-size: 48rpx;
  line-height: 48rpx;
  text-align: center;
}

.complete-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #24342D;
}

.complete-frog {
  width: 300rpx;
  height: 300rpx;
  border-radius: 24rpx;
}

.complete-subtitle {
  font-size: 32rpx;
  color: #666;
  font-weight: bold;
}

.action-btn {
  width: 100%;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid #24342D;
  background: transparent;
  color: #24342D;
}

.action-btn.primary {
  background: #24342D;
  color: #F7F4EC;
}

/* 金色纸屑庆祝动画 */
.confetti {
  position: absolute;
  top: -20rpx;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
}

.confetti__piece {
  position: absolute;
  top: -40rpx;
  width: 14rpx;
  height: 22rpx;
  border-radius: 4rpx;
  opacity: 0;
  animation: confetti-fall 1.6s ease-in forwards;
}

.confetti__piece--1 { left: 8%;  background: #D4A04A; animation-delay: 0s;    transform: rotate(20deg); }
.confetti__piece--2 { left: 20%; background: #C25B4E; animation-delay: 0.15s; transform: rotate(-35deg); }
.confetti__piece--3 { left: 32%; background: #7A9E7E; animation-delay: 0.3s;  transform: rotate(60deg); }
.confetti__piece--4 { left: 45%; background: #D4A04A; animation-delay: 0.1s;  transform: rotate(-10deg); }
.confetti__piece--5 { left: 58%; background: #C25B4E; animation-delay: 0.4s;  transform: rotate(45deg); }
.confetti__piece--6 { left: 70%; background: #7A9E7E; animation-delay: 0.05s; transform: rotate(-50deg); }
.confetti__piece--7 { left: 82%; background: #D4A04A; animation-delay: 0.25s; transform: rotate(30deg); }
.confetti__piece--8 { left: 92%; background: #C25B4E; animation-delay: 0.5s;  transform: rotate(-25deg); }

@keyframes confetti-fall {
  0%   { opacity: 0; transform: translateY(0) rotate(0deg); }
  10%  { opacity: 1; }
  100% { opacity: 0; transform: translateY(520rpx) rotate(320deg); }
}

/* 文化解读弹窗，采用角色墙同款单一滚动详情布局 */
.culture-modal {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 2000;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.culture-detail {
  position: relative;
  width: 100%;
  height: 88vh;
  padding: 28rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 32rpx;
}

.culture-detail__close {
  position: absolute;
  z-index: 1;
  top: 12rpx;
  right: 22rpx;
  width: 56rpx;
  height: 56rpx;
  color: #7B877F;
  font-size: 48rpx;
  line-height: 48rpx;
  text-align: center;
}

.culture-detail__image {
  display: block;
  width: 100%;
  height: 48vh;
  min-height: 360rpx;
  margin: 12rpx auto 8rpx;
}

.culture-detail__title {
  color: #24342D;
  font-size: 38rpx;
  font-weight: 700;
  text-align: center;
}

.culture-detail__meta {
  margin: 8rpx 24rpx 24rpx;
  color: #7B877F;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.culture-detail__section {
  padding-top: 20rpx;
  border-top: 1rpx solid #EEE9DF;
}

.culture-detail__heading {
  color: #1F5C46;
  font-size: 29rpx;
  font-weight: 700;
}

.culture-detail__paragraph {
  margin-top: 12rpx;
  color: #5E6A62;
  font-size: 25rpx;
  line-height: 1.75;
}
