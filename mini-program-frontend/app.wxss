page {
  background: #f7f4ec;
  color: #24342d;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx 48rpx;
}

scroll-view.page {
  height: calc(100vh - 44px - env(safe-area-inset-top));
  min-height: 0;
}

.section {
  margin-top: 32rpx;
}

.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title__main {
  color: #24342d;
  font-size: 34rpx;
  font-weight: 700;
}

.section-title__sub {
  color: #7b877f;
  font-size: 24rpx;
}

.surface {
  background: #fffdf8;
  border: 1rpx solid #e7e2d7;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.muted {
  color: #7b877f;
}

.primary-button {
  background: #1f5c46;
  border-radius: 10rpx;
  color: #fff;
  font-size: 28rpx;
  line-height: 88rpx;
}

.primary-button::after,
.ghost-button::after {
  border: 0;
}

.ghost-button {
  background: transparent;
  border: 1rpx solid #1f5c46;
  border-radius: 10rpx;
  color: #1f5c46;
  font-size: 26rpx;
  line-height: 76rpx;
}

.empty-state {
  padding: 48rpx 24rpx;
  color: #879189;
  text-align: center;
}
