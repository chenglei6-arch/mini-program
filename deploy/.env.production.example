# 生产环境变量模板：复制为 /opt/mini-program-backend/.env 后填入真实值。
# 该文件只存在于服务器上，权限设为 600 且属主为运行服务的账号，不要提交到仓库。

DB_NAME=mini_program
DB_USERNAME=mini_program_app
DB_PASSWORD=请替换为强密码
DB_URL=jdbc:mysql://127.0.0.1:3306/mini_program?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false

SERVER_PORT=8080
# 小程序 wx.request 不受浏览器同源策略约束，这里主要影响 Web 端调试
CORS_ALLOWED_ORIGINS=https://www.luolikongchenglei.asia

# 微信登录：生产必须填正式小程序凭据，否则登录不可用
WECHAT_APPID=
WECHAT_SECRET=
# 生产必须留空：填了会在未配置微信凭据时按该 openid 签发共享会话
APP_AUTH_DEV_OPENID=

AUTH_ACCESS_TOKEN_TTL=7200
# 正式部署必须为 false，避免测试数据出现在正式接口
CONTENT_INCLUDE_TEST_DATA=false

# 阿里云 OSS（v2 SDK）：上传接口与静态资源走同一 bucket；密钥不要写进 application.yml
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing
OSS_BUCKET=mini-program-wawa
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 静态资源公网地址，留空按 https://{bucket}.{endpoint} 推导
OSS_PUBLIC_BASE_URL=
